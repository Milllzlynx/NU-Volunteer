# ---- server ----
NODE_ENV=development
PORT=8080
# ต้นทางที่อนุญาต (frontend) — คั่นด้วย comma
CORS_ORIGINS=http://localhost:5173,https://nuv.nu.ac.th

# ---- database ----
# dev: SQLite  |  production: Postgres
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://nuv:secret@localhost:5432/nuvolunteer?schema=public"

# ---- auth ----
JWT_ACCESS_SECRET=change-me-32-chars-minimum-please
JWT_REFRESH_SECRET=change-me-too-32-chars-minimum-ok
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
COOKIE_DOMAIN=nu.ac.th
# ปิด secure cookie ได้เฉพาะตอน dev บน http
COOKIE_SECURE=true

# ---- email ----
MAIL_TRANSPORT=smtp           # smtp | sendgrid | ses | console
SMTP_HOST=smtp.nu.ac.th
SMTP_PORT=587
SMTP_USER=nuvolunteer@nu.ac.th
SMTP_PASS=
MAIL_FROM="NU Volunteer <no-reply@nu.ac.th>"
SENDGRID_API_KEY=
RESET_LINK_BASE=https://nuv.nu.ac.th/reset

# ---- policy ----
EMAIL_DOMAIN=nu.ac.th
RESET_TTL_MINUTES=30
LOGIN_RATE_MAX=5              # ครั้ง/นาที/IP
CAPTCHA_PROVIDER=turnstile    # turnstile | recaptcha | off
CAPTCHA_SECRET=
CAPTCHA_THRESHOLD=3           # ล้มเหลวกี่ครั้งจึงเริ่มบังคับ CAPTCHA
SEED_ENABLED=true             # ต้องเป็น false ใน production
