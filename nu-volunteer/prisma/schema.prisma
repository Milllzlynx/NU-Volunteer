// NU Volunteer — full domain schema
// sqlite ทั้ง dev และ production (ไฟล์เดียวจบ — ดู DEPLOYMENT.md)
//
// รูปแบบข้อมูลเหมือนเดิมทุกอย่าง ไม่ต้องแก้โค้ดที่อ่าน/เขียนฐานข้อมูล:
//   - ฟิลด์สถานะเก็บเป็น String (ค่าที่ใช้ได้ระบุไว้ในคอมเมนต์ของแต่ละฟิลด์)
//   - ฟิลด์ที่เป็นรายการ (perks, prep, gallery) ยังเก็บเป็น JSON string ผ่าน lib/json.ts
//     ไม่เปลี่ยนเป็น String[] เพื่อให้โค้ดที่อ่าน/เขียนผ่าน lib/json.ts ใช้ได้เหมือนเดิม
//
// ข้อควรระวังของ SQLite (ไม่กระทบสคีมานี้ แต่ต้องรู้ตอนเขียน query เพิ่ม):
//   - ไม่มี `mode: 'insensitive'` ใน where filter — ถ้าต้องค้นแบบไม่สนตัวพิมพ์
//     ให้เก็บฟิลด์ตัวพิมพ์เล็กคู่ไว้ แล้วค้นจากฟิลด์นั้นแทน
//   - เขียนได้ทีละ connection เท่านั้น จึงรันบน serverless (Vercel) ไม่ได้

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Prisma 7: connection URL อยู่ใน prisma.config.ts และส่ง adapter ให้ PrismaClient (ดู lib/db.ts)
datasource db {
  provider = "sqlite"
}

/* ───────────────────────── auth ───────────────────────── */

model User {
  id           String  @id @default(cuid())
  email        String  @unique // unique constraint จริงในฐานข้อมูล
  passwordHash String
  role         String  @default("student") // student | organizer | admin
  name         String  @default("")
  studentId    String?
  faculty      String?
  loanStatus   String? // yes | no  (ผู้กู้ยืม กยศ.)
  avatarUrl    String?
  phone        String?
  bio          String  @default("") // แนะนำตัวสั้น ๆ บนหน้าโปรไฟล์
  active       Boolean @default(true)
  seeded       Boolean @default(false)

  // ความเป็นส่วนตัว: ให้ผู้จัดกิจกรรมเห็นอีเมล/เบอร์โทรได้หรือไม่
  // (แอดมินเห็นเสมอเพื่อการดูแลระบบ — บังคับใช้จริงใน app/api/v1/search/route.ts)
  shareContact Boolean @default(true)

  // คำขอลบบัญชี — ผู้ใช้ส่งคำขอ แล้วแอดมินเป็นผู้ดำเนินการ
  // ไม่ลบทันทีเพราะชั่วโมงจิตอาสาและใบประกาศเป็นหลักฐานทางการศึกษา
  deletionRequestedAt DateTime?
  deletionReason      String?

  // ทุก token ที่ออกก่อนเวลานี้ถือว่าใช้ไม่ได้ (เปลี่ยนรหัสผ่าน / ออกจากทุกอุปกรณ์)
  tokensValidFrom DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions      Session[]
  resetTokens   PasswordResetToken[]
  twoFactor     TwoFactor?
  organized     Activity[]           @relation("ActivityOrganizer")
  registrations Registration[]
  favorites     Favorite[]
  certificates  Certificate[]
  notifications Notification[]
  reviews       Review[]
  appeals       Appeal[]             @relation("AppealStudent")
  appealsJudged Appeal[]             @relation("AppealJudge")
  evidenceSeen  Evidence[]           @relation("EvidenceReviewer")
  messages      ChatMessage[]
  threadsAsUser ChatThread[]         @relation("ThreadStudent")
  threadsAsStaff ChatThread[]        @relation("ThreadStaff")
  hourAdjustments HourAdjustment[]   @relation("AdjustmentStudent")
  adjustmentsMade HourAdjustment[]   @relation("AdjustmentAuthor")
  systemLogs    SystemLog[]
  calendarEvents CalendarEvent[]
  notifyPrefs   NotificationPreference?
  news          News[]

  @@index([role])
  @@index([faculty])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique // เก็บ hash ของ refresh token ไม่เก็บตัว token
  userAgent   String    @default("")
  ip          String    @default("")
  device      String    @default("")
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 ของ token ที่ส่งไปในอีเมล
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model TwoFactor {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled     Boolean   @default(false)
  pending     Boolean   @default(false)
  method      String    @default("totp") // totp | sms
  phone       String?
  secret      String? // เก็บ secret ของ TOTP (เข้ารหัสก่อนเก็บใน production)
  backupCodes String    @default("[]") // JSON: sha256 ของรหัสสำรองที่ยังไม่ถูกใช้
  enrolledAt  DateTime?
  updatedAt   DateTime  @updatedAt
}

// ผูกกับ System Log ฝั่งแอดมิน
model AuthLog {
  id        String   @id @default(cuid())
  event     String // login.success | login.failed | register | forgot | reset | logout.others | ratelimit.block
  email     String   @default("")
  ip        String   @default("")
  userAgent String   @default("")
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([email, createdAt])
}

/* ───────────────────── master data ───────────────────── */

model Faculty {
  id        String   @id @default(cuid())
  name      String   @unique
  /** ชื่อคณะภาษาอังกฤษ — ใช้ตอนสลับภาษาและตอนส่งออกไฟล์ให้หน่วยงานภายนอก */
  nameEn    String   @default("")
  /** ตัวย่อ เช่น "คณศ." — ใช้ในตารางแคบ ๆ ที่ชื่อเต็มยาวเกินไป */
  abbr      String   @default("")
  /** ข้อมูลติดต่อของคณะ (ไม่ใช่ของนิสิต) — เปิดให้เจ้าหน้าที่ใช้ประสานงาน */
  email     String   @default("")
  phone     String   @default("")
  location  String   @default("")
  /** ปิดคณะที่ยุบหรือควบรวมแล้ว โดยไม่ลบทิ้ง เพราะนิสิตเดิมยังอ้างถึงอยู่ */
  active    Boolean  @default(true)
  colorName String   @default("")
  color     String   @default("#A774F7")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Category {
  id        String     @id // slug: acad | service | morality | arts | health | recreation | public
  label     String
  labelEn   String     @default("")
  /** คำอธิบายสั้น ๆ ว่าหมวดนี้ครอบคลุมกิจกรรมแบบไหน — แสดงในหน้าจัดการหมวดหมู่ */
  desc      String     @default("")
  /** ชื่อไอคอน Material Symbols เช่น "school" — ว่างไว้ได้ จะใช้จุดสีแทน */
  icon      String     @default("")
  color     String     @default("#A774F7")
  order     Int        @default(0)
  active    Boolean    @default(true)
  activities Activity[]
}

/* ───────────────────── activities ───────────────────── */

model Activity {
  id          String  @id @default(cuid())
  title       String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  organizerId String
  organizer   User     @relation("ActivityOrganizer", fields: [organizerId], references: [id])
  orgName     String   @default("") // ชื่อหน่วยงาน/ชมรมที่แสดงบนการ์ด
  description String   @default("")

  location String  @default("")
  lat      Float?
  lng      Float?
  mapLink  String?
  // รัศมีที่ยอมรับสำหรับการเช็กอินด้วย GPS (เมตร)
  geoRadiusM Int   @default(300)

  startAt    DateTime
  endAt      DateTime
  regOpenAt  DateTime?
  regCloseAt DateTime?

  seatsTotal Int    @default(0)
  hours      Float  @default(0)
  status     String @default("open") // draft | open | closed | cancelled | done

  photo   String? // hero
  gallery String  @default("[]") // JSON: [url, url]
  mapImage String?
  perks   String  @default("[]") // JSON: string[]
  prep    String  @default("[]") // JSON: string[]
  /// หมายเหตุพิเศษจากผู้จัด — ข้อความอิสระ ไม่ใช่รายการเหมือน perks/prep
  notes   String  @default("")

  // ต้องอนุมัติผู้สมัครก่อนหรือไม่ (ค่าเริ่มต้น: ต้องอนุมัติ)
  requiresApproval Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations Registration[]
  favorites     Favorite[]
  certificates  Certificate[]
  reviews       Review[]
  checkinTokens CheckinToken[]
  threads       ChatThread[]
  sessions      ActivitySession[]

  @@index([status, startAt])
  @@index([organizerId])
  @@index([categoryId])
}

/// รอบ/ผลัดของกิจกรรมเดียวกัน เช่น "NU Run" มีรอบเช้า รอบบ่าย รอบเย็น
///
/// ตั้งชื่อ ActivitySession ไม่ใช่ Session เพราะ Session ถูกใช้เป็นเซสชันการเข้าสู่ระบบไปแล้ว
///
/// เป็นชั้นวางแผนของผู้จัดกิจกรรม — ใบลงทะเบียนยังผูกกับกิจกรรมเหมือนเดิม
/// แล้วค่อยถูกจัดเข้ารอบผ่าน Registration.sessionId ซึ่งเป็นค่าที่ว่างได้
/// จึงไม่กระทบการนับที่นั่งและการสมัครฝั่งนิสิตที่ทำงานอยู่แล้ว
model ActivitySession {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  name        String // ชื่อรอบ เช่น "รอบเช้า" หรือ "ผลัดที่ 1"
  description String @default("")
  location    String @default("") // เว้นว่าง = ใช้สถานที่เดียวกับกิจกรรม

  startAt DateTime
  endAt   DateTime

  capacity Int    @default(0) // 0 = ไม่จำกัด
  status   String @default("draft") // draft | active | completed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations Registration[]

  @@index([activityId, startAt])
  @@index([status])
}

model Registration {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  /// รอบที่ถูกจัดเข้า — ว่างได้ เพราะกิจกรรมส่วนใหญ่มีรอบเดียวและไม่ต้องแบ่ง
  /// ลบรอบแล้วใบลงทะเบียนต้องไม่หายไปด้วย จึงใช้ SetNull ไม่ใช่ Cascade
  sessionId String?
  session   ActivitySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // pending | approved | rejected | checked-in | checked-out | completed | cancelled | no-show
  status String @default("pending")
  regAt  DateTime @default(now())

  approvedAt DateTime?
  rejectedAt DateTime?
  rejectReason String?

  checkedInAt  DateTime?
  checkedOutAt DateTime?
  checkinLat   Float?
  checkinLng   Float?
  // เช็กอินนอกรัศมีที่กำหนด — บันทึกไว้ให้ผู้จัดพิจารณา ไม่บล็อกทันที
  checkinOutOfRange Boolean @default(false)

  // ชั่วโมงที่คำนวณได้จากช่วงเช็กอิน–เช็กเอาต์ และชั่วโมงที่รับรองแล้ว
  hoursComputed Float  @default(0)
  hoursAwarded  Float  @default(0)
  hoursApprovedAt DateTime?

  cancelRequested Boolean   @default(false)
  cancelReason    String?
  cancelStatus    String? // pending | approved | rejected
  cancelledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence    Evidence[]
  appeals     Appeal[]
  certificate Certificate?

  @@unique([userId, activityId])
  @@index([activityId, status])
  @@index([userId, status])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, activityId])
}

// QR ของผู้จัด — หมุนรหัสเป็นระยะและมีเวลาหมดอายุ (สแกนภาพถ่ายเก่าไม่ผ่าน)
model CheckinToken {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  code       String   @unique
  kind       String   @default("in") // in | out
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([activityId, expiresAt])
}

model Evidence {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fileUrl        String
  fileName       String       @default("")
  mimeType       String       @default("")
  sizeBytes      Int          @default(0)
  note           String       @default("")

  status       String    @default("pending") // pending | approved | rejected
  reviewedById String?
  reviewedBy   User?     @relation("EvidenceReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())

  @@index([registrationId])
  @@index([status])
}

model Appeal {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("AppealStudent", fields: [userId], references: [id], onDelete: Cascade)

  reason  String
  fileUrl String?

  status       String    @default("pending") // pending | approved | rejected
  decidedById  String?
  decidedBy    User?     @relation("AppealJudge", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?
  // ส่งต่อให้แอดมินตัดสินแทนผู้จัด
  escalated    Boolean   @default(false)

  createdAt DateTime @default(now())

  @@index([status])
  @@index([userId])
}

// การปรับชั่วโมงด้วยมือ (ผลอุทธรณ์ / แอดมินแก้ไข) — แยกจาก Registration เพื่อให้ตรวจสอบย้อนหลังได้
model HourAdjustment {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation("AdjustmentStudent", fields: [userId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("AdjustmentAuthor", fields: [authorId], references: [id])

  hours        Float // บวก/ลบได้
  reason       String
  academicYear Int
  createdAt    DateTime @default(now())

  @@index([userId, academicYear])
}

model Certificate {
  id             String        @id @default(cuid())
  ref            String        @unique // NUV-2569-XXXXX (ใช้ในหน้า verify สาธารณะ)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId     String
  activity       Activity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  registrationId String?       @unique
  registration   Registration? @relation(fields: [registrationId], references: [id])

  hours     Float
  issuedAt  DateTime  @default(now())
  revokedAt DateTime?
  revokeReason String?

  @@index([userId])
}

model Review {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stars      Int      @default(5)
  comment    String   @default("")
  createdAt  DateTime @default(now())

  @@unique([activityId, userId])
  @@index([activityId])
}

/* ───────────────── communication ───────────────── */

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // approval | reminder | message | certificate | kyf | system
  type  String @default("system")
  title String
  body  String @default("")
  link  String?

  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model ChatThread {
  id         String    @id @default(cuid())
  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  studentId String
  student   User   @relation("ThreadStudent", fields: [studentId], references: [id], onDelete: Cascade)
  staffId   String
  staff     User   @relation("ThreadStaff", fields: [staffId], references: [id], onDelete: Cascade)

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  // ปิดเสียง/เก็บเข้าคลัง — ฝั่งนิสิตเท่านั้น เพราะยังไม่มีหน้าจอฝั่งผู้จัด
  // เพิ่มคู่ของฝั่งเจ้าหน้าที่เมื่อสร้างหน้าแชทของผู้จัดแล้ว
  studentMuted    Boolean @default(false)
  studentArchived Boolean @default(false)

  messages ChatMessage[]

  @@unique([activityId, studentId, staffId])
  @@index([studentId])
  @@index([staffId])
}

model ChatMessage {
  id       String     @id @default(cuid())
  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId String
  sender   User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  text      String
  readAt    DateTime?
  deletedAt DateTime?
  // null = เห็นได้ทั้งสองฝ่าย
  // 'me:<userId>[,me:<userId>]' = ฝ่ายที่ระบุกดลบสำหรับตัวเอง อีกฝ่ายยังเห็นข้อความเต็ม
  // 'all' = ลบให้ทุกคนเห็น (แอดมินหรือผู้ส่งภายในเวลาที่กำหนด) ใช้คู่กับ deletedAt
  // อ่าน/เขียนผ่าน visibleTo() กับ hiddenMark() ใน lib/chat.ts เท่านั้น —
  // เงื่อนไข NOT ตรง ๆ จะตกแถวที่คอลัมน์นี้เป็น NULL ซึ่งคือข้อความปกติทั้งหมด
  deleteScope String?

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

model ContactMessage {
  id       String   @id @default(cuid())
  fromName String
  email    String   @default("")
  subject  String   @default("")
  text     String
  read     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
}

/* ───────────────── content & ops ───────────────── */

model News {
  id    String @id @default(cuid())
  title String
  /** เนื้อหาเก็บเป็นข้อความล้วนที่ใส่เครื่องหมายอย่างมาร์กดาวน์ได้ (ดู lib/richText.ts)
      ไม่เก็บเป็น HTML เพราะจะกลายเป็นช่องทางฝัง script เมื่อนำไปแสดง */
  body  String @default("")

  /** draft = ยังไม่เผยแพร่ · published = เผยแพร่แล้ว · archived = เก็บเข้ากรุ ไม่แสดงแต่ไม่ลบ */
  status String @default("draft")
  /** เวลาที่ตั้งให้เผยแพร่ — อนาคตคือตั้งเวลาไว้ล่วงหน้า ยังไม่ถือว่าออกสู่สาธารณะ */
  publishedAt DateTime?

  /** ที่อยู่ของภาพประกอบ (URL) — โปรเจกต์นี้ยังไม่มีปลายทางอัปโหลดไฟล์ */
  image String?
  /** ปักหมุดให้ลอยขึ้นบนสุดเสมอ ไม่ว่าจะลงวันไหน */
  pinned Boolean @default(false)
  /** public = ใครก็อ่านได้ · members = เฉพาะผู้ที่เข้าสู่ระบบแล้ว */
  audience String @default("public")
  /** จำนวนครั้งที่ถูกเปิดอ่าน — เพิ่มจากหน้าอ่านข่าว ไม่ใช่จากหน้าจัดการ */
  views Int @default(0)
  /** ป้ายกำกับ เก็บเป็น JSON array ของสตริง แบบเดียวกับ Activity.perks/gallery */
  tags String @default("[]")

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([pinned, publishedAt])
}

model Banner {
  id        String  @id @default(cuid())
  title     String
  desc      String  @default("")
  image     String?
  ctaLabel  String  @default("")
  ctaTarget String  @default("") // key ของหน้าใน ROLE_NAV
  type      String  @default("general") // general | reminder | update
  visible   Boolean @default(true)
  order     Int     @default(0)
  createdAt DateTime @default(now())
}

model SystemLog {
  id      String  @id @default(cuid())
  level   String  @default("info") // info | success | warning | error
  text    String
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  meta    String  @default("{}") // JSON

  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([createdAt])
}

model EmailLog {
  id      String @id @default(cuid())
  event   String
  to      String
  lang    String @default("th")
  subject String
  body    String @default("")

  status   String    @default("sending") // sending | retrying | sent | failed
  attempts Int       @default(0)
  error    String?
  sentAt   DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model Backup {
  id       String   @id @default(cuid())
  trigger  String   @default("manual") // manual | scheduled
  status   String   @default("success") // success | failed
  sizeMb   Float    @default(0)
  location String   @default("")
  error    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ค่าตั้งค่าระบบแบบ key/value — maintenance mode, เกณฑ์ชั่วโมง กยศ., เปิด/ปิดสมัครสมาชิก ฯลฯ
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/* ───────────────── ปฏิทินส่วนตัว ───────────────── */

// นัดหมายที่นิสิตเพิ่มเองบนปฏิทิน (เตือนความจำ/ธุระส่วนตัว)
// ไม่ใช่กิจกรรมจิตอาสา — ไม่นับชั่วโมง ไม่มีการอนุมัติ และเห็นได้เฉพาะเจ้าของ
model CalendarEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String
  note  String @default("")

  startAt DateTime
  endAt   DateTime?
  // จริง = ทั้งวัน (ไม่สนใจเวลาใน startAt/endAt)
  allDay  Boolean   @default(true)

  // สีป้ายบนปฏิทิน — เก็บเป็น hex ตามจานสีใน lib/design.ts
  color String @default("#A774F7")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startAt])
}

/* ───────────────── ตั้งค่าการแจ้งเตือน ───────────────── */

// ผู้ใช้เลือกได้ว่าอยากรับการแจ้งเตือนแบบไหนบ้าง — หนึ่งแถวต่อหนึ่งคน
// ไม่มีแถว = ใช้ค่าเริ่มต้นทั้งหมด (ดู DEFAULT_PREFS ใน lib/alerts.ts)
model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // เตือนก่อนถึงวันกิจกรรมที่ลงทะเบียนไว้
  activityReminder Boolean @default(true)
  // เตือนก่อนปิดรับสมัครกิจกรรมที่กดถูกใจไว้
  deadlineReminder Boolean @default(true)
  // ประกาศจากระบบ/ผู้ดูแล
  systemNotice     Boolean @default(true)
  // ข้อความจากผู้จัดกิจกรรม
  chatMessage      Boolean @default(true)

  // เตือนล่วงหน้ากี่วัน (1–14)
  leadDays Int @default(3)

  // ส่งอีเมลด้วยหรือไม่ — ยังไม่มีตัวส่งจริง เก็บค่าไว้ให้พร้อมใช้
  emailEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
